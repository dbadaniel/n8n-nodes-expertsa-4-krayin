{
  "name": "n8n-nodes-expertsa-4-krayin",
  "version": "1.0.2",
  "description": "n8n community node for Krayin CRM API integration - Full coverage for Leads, Persons, Organizations, Activities, Products, and Pipelines",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "krayin",
    "krayin-crm",
    "crm",
    "api",
    "leads",
    "contacts",
    "organizations",
    "pipeline"
  ],
  "license": "MIT",
  "homepage": "https://github.com/dbadaniel/n8n-nodes-expertsa-4-krayin#readme",
  "author": {
    "name": "Expertsa",
    "email": "expertsa.oficial@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbadaniel/n8n-nodes-expertsa-4-krayin.git"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint . --ext .ts",
    "lintfix": "eslint . --ext .ts --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "Exsa-azul.png",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KrayinApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Krayin/Krayin.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
